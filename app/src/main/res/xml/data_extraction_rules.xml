<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+). See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keystore-protected key material cannot be restored on another device,
             so it must not be uploaded in the first place. -->
        <exclude domain="sharedpref" path="sali_hcnsec_sec_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sali_hcnsec_sec_store.xml" />
    </device-transfer>
</data-extraction-rules>
