<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules (API < 31). See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Provider API keys are encrypted with a hardware-backed Keystore key that
         is never itself backed up, so a restored ciphertext is undecryptable and
         only risks leaking key material. Keep the secret store out of backups. -->
    <exclude domain="sharedpref" path="sali_hcnsec_sec_store.xml" />
</full-backup-content>
